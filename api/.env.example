PORT=5000
# Allowed browser origins, comma separated (web dev server, then the deployed web URL)
CLIENT_ORIGIN=http://localhost:5173

# --- Database (local MySQL or Aiven MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=roadwatch
# Aiven typically requires TLS. Set DB_SSL=true and paste the CA certificate text
# (use \n for line breaks) into DB_SSL_CA, or point DB_SSL_CA_PATH to the downloaded ca.pem
DB_SSL=false
DB_SSL_CA=
DB_SSL_CA_PATH=

# --- Auth ---
# REQUIRED: the API refuses to start with this placeholder. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# --- First administrator (used only by: npm run seed:admin) ---
ADMIN_NAME=System Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Photos ---
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- Email: Brevo transactional email API over HTTPS (#37) ---
# MAIL_PROVIDER=log prints emails to the console (local dev and tests). MAIL_PROVIDER=brevo sends them
# (set BREVO_API_KEY on Render only). Leave it empty to turn email off; in-app notifications still work.
MAIL_PROVIDER=log
MAIL_FROM="RoadWatch <no-reply@roadwatch-ph.me>"
BREVO_API_KEY=

# --- Demo video (Cloudinary URL, set after recording) ---
DEMO_VIDEO_URL=
