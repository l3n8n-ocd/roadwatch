PORT=5000
# Allowed browser origins, comma separated (web dev server, then the deployed web URL)
CLIENT_ORIGIN=http://localhost:5173

# --- Database (local MySQL or Aiven MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=roadwatch
# Aiven typically requires TLS. Set DB_SSL=true and paste the CA certificate text
# (use \n for line breaks) into DB_SSL_CA, or point DB_SSL_CA_PATH to the downloaded ca.pem
DB_SSL=false
DB_SSL_CA=
DB_SSL_CA_PATH=

# --- Auth ---
# REQUIRED: the API refuses to start with this placeholder. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# --- First administrator (used only by: npm run seed:admin) ---
ADMIN_NAME=System Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Photos ---
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- Email: Nodemailer using Gmail SMTP (needs 2-step verification and an app password) ---
# MAIL_PROVIDER=smtp is the decided demo setup. Resend is optional and only works for other
# recipients after you verify a domain.
MAIL_PROVIDER=smtp
MAIL_FROM="RoadWatch <your-gmail-address@gmail.com>"
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Demo video (Cloudinary URL, set after recording) ---
DEMO_VIDEO_URL=
